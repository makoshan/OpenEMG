{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-hw.local/emg/commons_row.schema.json",
  "title": "CommonsRow",
  "description": "One shared window. Derived from CaptureSession with identifiers re-labelled per bundle (s01, d01), time relative to the bundle's first window, closed context enums only. raw_window only when the manifest consents to the raw tier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session", "donning", "gesture_label", "t_ms", "fs_hz", "window_ms", "feature_window", "quality", "held_out"],
  "properties": {
    "session": { "type": "string", "pattern": "^s[0-9]{2,4}$" },
    "donning": { "type": "string", "pattern": "^d[0-9]{2,4}$" },
    "gesture_label": { "type": "string", "enum": ["rest", "light", "hard", "lead_off_neg", "confirm_pulse"] },
    "t_ms": { "type": "number", "minimum": 0 },
    "fs_hz": { "type": "number", "exclusiveMinimum": 0 },
    "window_ms": { "type": "number", "exclusiveMinimum": 0 },
    "feature_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norm"],
      "properties": {
        "band": { "type": "integer", "enum": [0, 1, 2] },
        "norm": { "type": "number", "minimum": 0, "maximum": 1 },
        "env": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead_off", "poor_contact", "line_noise", "clip", "artifact_suspect"],
      "properties": {
        "lead_off": { "type": "boolean" },
        "poor_contact": { "type": "boolean" },
        "line_noise": { "type": "boolean" },
        "clip": { "type": "boolean" },
        "artifact_suspect": { "type": "boolean" }
      }
    },
    "held_out": { "type": "boolean" },
    "posture": { "type": "string", "enum": ["sit", "stand", "walk", "lie"] },
    "strap_nuisance": { "type": "string", "enum": ["none", "shift", "loose", "tight"] },
    "raw_window": { "type": "array", "items": { "type": "number" } }
  }
}
