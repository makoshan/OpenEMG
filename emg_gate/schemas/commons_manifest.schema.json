{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-hw.local/emg/commons_manifest.schema.json",
  "title": "CommonsManifest",
  "description": "Contribution bundle manifest. Pseudonymous: no user_id / device_id / absolute time. contributor = c_ + sha256(pubkey)[:16]; sig is Ed25519 over the manifest without sig, so any replica can verify it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "contributor",
    "pubkey",
    "hardware",
    "pool_key",
    "consent",
    "source",
    "counts",
    "files",
    "tool",
    "sig"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^b_[0-9a-f]{16}$"
    },
    "contributor": {
      "type": "string",
      "pattern": "^c_[0-9a-f]{16}$"
    },
    "hardware": {
      "type": "object"
    },
    "pool_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tiers",
        "license",
        "allow_model_training",
        "granted_on"
      ],
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "commons-consent-v1"
          ]
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "features",
              "raw"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "features"
          }
        },
        "license": {
          "type": "string",
          "enum": [
            "CDLA-Permissive-2.0",
            "CDLA-Sharing-1.0",
            "CC-BY-4.0",
            "ODbL-1.0"
          ]
        },
        "allow_model_training": {
          "type": "boolean",
          "const": true
        },
        "granted_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "recorded",
        "synthetic"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_rows",
        "n_sessions",
        "n_donnings",
        "clean_seconds",
        "has_raw"
      ],
      "properties": {
        "n_rows": {
          "type": "integer",
          "minimum": 1
        },
        "n_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "n_donnings": {
          "type": "integer",
          "minimum": 1
        },
        "clean_seconds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "has_raw": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows.jsonl"
      ],
      "properties": {
        "windows.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emg_gate"
      ],
      "properties": {
        "emg_gate": {
          "type": "string"
        }
      }
    },
    "pubkey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
