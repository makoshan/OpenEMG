{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-hw.local/emg/capture_session.schema.json",
  "title": "CaptureSession",
  "description": "P0 capture window. Whitelist fields per ADR-2026-09-23-EMG §1.1. raw_window is local-only and never leaves the device by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "device_id",
    "session_id",
    "donning_id",
    "gesture_label",
    "obs_ts_device_ms",
    "obs_ts_host_ms",
    "fs_hz",
    "window_ms",
    "payload_kind",
    "quality"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "user_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "donning_id": { "type": "string", "minLength": 1 },
    "gesture_label": {
      "type": "string",
      "enum": ["rest", "light", "hard", "lead_off_neg", "confirm_pulse"]
    },
    "obs_ts_device_ms": { "type": "number" },
    "obs_ts_host_ms": { "type": "number" },
    "fs_hz": { "type": "number", "exclusiveMinimum": 0 },
    "window_ms": { "type": "number", "exclusiveMinimum": 0 },
    "payload_kind": { "type": "string", "enum": ["raw_window", "feature_window"] },
    "raw_window": {
      "description": "Local only. Stripped by default export; never in CloudSafeEvent.",
      "type": "array",
      "items": { "type": "number" }
    },
    "feature_window": {
      "type": "object",
      "properties": {
        "band": { "type": "integer", "enum": [0, 1, 2] },
        "norm": { "type": "number", "minimum": 0, "maximum": 1 },
        "env": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead_off", "poor_contact", "line_noise", "clip", "artifact_suspect"],
      "properties": {
        "lead_off": { "type": "boolean" },
        "poor_contact": { "type": "boolean" },
        "line_noise": { "type": "boolean" },
        "clip": { "type": "boolean" },
        "artifact_suspect": { "type": "boolean" },
        "snr_hint": { "type": "number" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posture_tag": { "type": "string" },
        "strap_nuisance": { "type": "string", "enum": ["none", "shift", "loose", "tight"] },
        "force_intent": { "type": "string" }
      }
    },
    "held_out": { "type": "boolean", "default": false },
    "export_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "local_only": { "type": "boolean" } }
    },
    "source": {
      "type": "string",
      "enum": ["recorded", "synthetic"],
      "default": "recorded",
      "description": "Data source: recorded from device or synthetic generated"
    }
  },
  "allOf": [
    {
      "description": "Positive gestures must not carry lead_off or clip (ADR §1.1 reject rule).",
      "if": {
        "properties": { "gesture_label": { "enum": ["rest", "light", "hard", "confirm_pulse"] } }
      },
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "lead_off": { "const": false },
              "clip": { "const": false }
            }
          }
        }
      }
    }
  ]
}
